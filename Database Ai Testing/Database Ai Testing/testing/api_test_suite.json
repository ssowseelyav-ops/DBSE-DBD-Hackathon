{
  "info": {
    "name": "Smart Campus Complaint Management - API Test Suite",
    "description": "Postman test suite for testing Member 1, Member 2, and Member 3 APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Dashboard Stats",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/api/dashboard/stats"
      }
    },
    {
      "name": "2. Get All Complaints",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/api/complaints"
      }
    },
    {
      "name": "3. Submit New Complaint",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentName\": \"Sowseelya V\",\n  \"studentEmail\": \"sowseelya@campus.edu\",\n  \"title\": \"Library Wi-Fi dropped connection\",\n  \"description\": \"Signal strength is low on the 2nd floor\",\n  \"category\": \"WIFI\",\n  \"location\": \"Central Library, 2nd Floor\",\n  \"priority\": \"HIGH\"\n}"
        },
        "url": "http://localhost:8080/api/complaints"
      }
    },
    {
      "name": "4. Update Complaint Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
        },
        "url": "http://localhost:8080/api/complaints/1/status"
      }
    },
    {
      "name": "5. User Registration",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Student\",\n  \"email\": \"aarav.test@campus.edu\",\n  \"password\": \"studentpass\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": "http://localhost:8080/api/auth/register"
      }
    },
    {
      "name": "6. User Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"aarav.test@campus.edu\",\n  \"password\": \"studentpass\"\n}"
        },
        "url": "http://localhost:8080/api/auth/login"
      }
    }
  ]
}
